{
  "name": "cyp-memo",
  "version": "2.0.1",
  "type": "module",
  "private": true,
  "description": "CYP-memo 备忘录系统",
  "homepage": "https://github.com/ADdss-hub/CYP-memo",
  "author": {
    "name": "CYP",
    "email": "nasDSSCYP@outlook.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "local:all": "node scripts/start/ensure-app-dist.js && node scripts/start/run-local-all.mjs",
    "local:hmr": "concurrently \"pnpm local:server\" \"pnpm --filter @cyp-memo/app local\"",
    "local:server": "pnpm --filter @cyp-memo/server local",
    "local:kms": "pnpm --filter @cyp-memo/server kms:local",
    "build": "node scripts/install/build.js",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "release": "node scripts/install/release.js",
    "release:patch": "node scripts/install/release.js patch",
    "release:minor": "node scripts/install/release.js minor",
    "release:major": "node scripts/install/release.js major",
    "version:info": "node scripts/verify/verify-version.js",
    "version:bump": "node scripts/install/version-bump.js",
    "verify:encoding": "python scripts/verify/verify-encoding-clean.py .",
    "verify:ci02": "python scripts/verify/verify-ci02-prod-baseline.py .",
    "verify:storage-ssot": "node scripts/verify/verify-server-storage-ssot.mjs",
    "verify:complete-form": "node scripts/verify/verify-complete-form.mjs",
    "verify:automation-matrix": "node scripts/verify/verify-automation-matrix.mjs",
    "verify:runtime-base": "node scripts/verify/verify-runtime-base.mjs",
    "verify:gateway-center-naming": "node scripts/verify/verify-gateway-center-naming.mjs",
    "verify:gateway-egress": "node scripts/verify/verify-gateway-egress.mjs",
    "verify:font-glyph": "node scripts/verify/verify-font-glyph.mjs",
    "verify:cdc-contracts": "pnpm --filter @cyp-memo/server exec tsx scripts/verify-cdc-contracts.ts",
    "verify:mcp-gateway-proxy": "pnpm --filter @cyp-memo/server exec tsx scripts/verify-mcp-gateway-proxy.ts",
    "verify:embedded-equivalents": "pnpm --filter @cyp-memo/server exec tsx scripts/verify-embedded-equivalents.ts",
    "verify:gates": "pnpm verify:encoding && pnpm verify:ci02 && pnpm verify:font-glyph && pnpm verify:gateway-center-naming && pnpm verify:runtime-base && pnpm verify:complete-form && pnpm verify:cdc-contracts && pnpm verify:mcp-gateway-proxy && pnpm verify:embedded-equivalents && pnpm verify:automation-matrix && pnpm verify:storage-ssot && pnpm verify:gateway-egress && pnpm verify:perf-evid && pnpm verify:r008-save-path && pnpm verify:r008-large-payload && pnpm verify:perf-coverage && pnpm verify:perf-upgrade",
    "verify:support-desktop": "node scripts/verify/verify-support-desktop.mjs",
    "verify:electron-embed": "node scripts/verify/verify-electron-embed.mjs",
    "verify:perf-upgrade": "pnpm --filter @cyp-memo/server exec tsx scripts/perf-upgrade-verify.ts",
    "verify:perf-coverage": "pnpm --filter @cyp-memo/server exec tsx scripts/perf-coverage-verify.ts",
    "verify:perf-evid": "node scripts/verify/verify-perf-evid.mjs",
    "verify:r008-save-path": "node scripts/verify/verify-r008-save-path.mjs",
    "verify:r008-large-payload": "pnpm --filter @cyp-memo/server exec tsx scripts/r008-large-payload-verify.ts",
    "local": "node scripts/start/local.js",
    "mcp:local": "pnpm --filter @cyp-memo/mcp local:http",
    "mcp:stdio": "pnpm --filter @cyp-memo/mcp exec tsx src/index.ts --stdio",
    "api:tls-probe": "pnpm --filter @cyp-memo/server exec tsx scripts/api-tls-probe.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=20.19.6",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "node-gyp": "10.3.1",
      "fflate": "0.8.3",
      "qs": "6.16.0",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "shell-quote": "1.10.0",
      "tar": "7.5.22",
      "@xmldom/xmldom": "^0.8.15",
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.18",
      "postcss": "8.5.28",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "minimatch@3": "3.1.5",
      "minimatch@5": "5.1.9",
      "minimatch@9": "9.0.9",
      "path-to-regexp": "0.1.13",
      "linkify-it": "5.0.2",
      "sharp": "0.35.5",
      "rollup": "4.63.5",
      "ws": "8.22.0",
      "form-data": "4.0.6",
      "js-cookie": "3.0.8",
      "tmp": "0.2.7",
      "flatted": "3.4.4",
      "picomatch@2": "2.3.2",
      "markdown-it": "14.3.1",
      "body-parser": "1.20.6",
      "@tiptap/core": "3.30.5",
      "electron-builder-squirrel-windows": "26.15.3"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "keytar",
      "electron",
      "esbuild",
      "sharp"
    ]
  }
}
