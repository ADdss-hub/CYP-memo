{
  "title": "CYP-memo - Start Local",
  "uid": "cyp-start-local",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["cyp-memo", "local", "slo"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": {} }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cold Start Duration P95 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(start_local_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "thresholds": [
        { "color": "green", "value": null },
        { "color": "red", "value": 120 }
      ]
    },
    {
      "id": 2,
      "title": "Cold Start Duration (raw, s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "start_local_duration_seconds", "legendFormat": "last_start" }
      ]
    },
    {
      "id": 3,
      "title": "Start Status (1=ok)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "start_local_up", "legendFormat": "up" }
      ]
    },
    {
      "id": 4,
      "title": "SLO-START Budget (≤120s) Gauge",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(start_local_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 240,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 120 }
            ]
          }
        }
      }
    }
  ]
}
