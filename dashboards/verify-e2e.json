{
  "title": "CYP-memo - Verify E2E",
  "uid": "cyp-verify-e2e",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["cyp-memo", "verify", "slo"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": {} }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Verify E2E Success Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(verify_e2e_total{result=\"pass\"}[10m])) / clamp_min(sum(rate(verify_e2e_total[10m])), 1e-9) * 100",
          "legendFormat": "success_rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Verify E2E Total (pass/fail)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(verify_e2e_total[10m])) by (result)", "legendFormat": "{{result}}" }
      ]
    },
    {
      "id": 3,
      "title": "Failure Rate > 10% Breaches",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max((sum(rate(verify_e2e_total{result=\"fail\"}[10m])) / clamp_min(sum(rate(verify_e2e_total[10m])), 1e-9) - 0.10) * 100, 0) * -1",
          "legendFormat": "over_budget_pct"
        }
      ]
    },
    {
      "id": 4,
      "title": "SLO-VERIFY Gauge (target ≥90%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(verify_e2e_total{result=\"pass\"}[10m])) / clamp_min(sum(rate(verify_e2e_total[10m])), 1e-9) * 100",
          "legendFormat": "success_rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 90 }
            ]
          }
        }
      }
    }
  ]
}
