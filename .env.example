# CYP-memo 环境变量配置模板
# 复制此文件为 .env 并根据需要修改配置
#
# 安全提示：
# - 不要将 .env 文件提交到版本控制
# - 生产环境中使用强密码和安全的配置值
# - 定期审查和更新配置

# ============================================
# 基础配置（CI02 · 生产唯一基准 · 仅允许 prod / production）
# ============================================

# 应用环境标识：军械库强制固定 prod（其它取值一律拒绝）
APP_ENV=prod

# Node 进程模式：固定 production（其它取值一律纠正）
NODE_ENV=production

# 服务端口号 (1-65535)
# 默认: 5170（产品统一入口：静态资源 + API 代理 + MCP 代理）
PORT=5170

# 后端 API 服务端口（仅环回 127.0.0.1，不直接对外暴露）
# 默认: 10170（后端 API 范围 10000-10999）
API_PORT=10170

# 数据存储目录（配置中心 B01 · 日志/管控/SQLite 根）
# 面板/NAS/Windows/Unix 安装脚本会写入实际路径
# 本机 start-local：请留空/注释，由 packages/server 锚定 packages/server/data
# DATA_DIR=

# ============================================
# 日志配置（日志中心 B15）
# ============================================

# 日志级别 (debug | info | warn | error)
LOG_LEVEL=info

# ============================================
# 时区配置
# ============================================

TZ=Asia/Shanghai

# ============================================
# 前端 / Vite（CFG-SYS-07 · 可选）
# ============================================

# VITE_API_BASE=/api
# VITE_API_PROXY_TARGET=http://127.0.0.1:5170

# ============================================
# 桌面端网络探测（AUD-C02 · 可选）
# ============================================

# CYP_NETWORK_CHECK_URL=offline-ok

# ============================================
# 首次启动 Owner 口令（可选 · CFG-SYS-05）
# ============================================

# 仅空库首次 bootstrap 种子使用。留空 = 不建种子账号，请走自助注册。
# CYP_BOOTSTRAP_OWNER_PASSWORD=

# ============================================
# 管控 / 机器码（管控中心 B14 · 可选）
# ============================================

# CYP_EXPECTED_MACHINE_ID=
# CYP_KILL_SWITCH=

# ============================================
# KMS 密钥保险箱（独立服务 · P1 改造）
# ============================================

# KMS 独立服务监听端口（基础设施服务段 12000-12999）
# 仅监听 127.0.0.1，不对外暴露
# 默认: 12000
KMS_PORT=12000

# KMS 服务间认证 Token（East-West Token）
# 主服务与 KMS 服务之间共享的认证密钥
# 生产环境请使用强随机值（建议 32+ 字节）
# 留空则使用嵌入式模式（KMS 与主服务同进程）
KMS_AUTH_TOKEN=

# 强制启用远程 KMS 模式（可选）
# 设置为 1 时，即使 KMS_AUTH_TOKEN 未配置也尝试远程连接
# 默认: 0（自动检测 KMS_PORT+KMS_AUTH_TOKEN 同时配置则启用远程）
# CYP_KMS_REMOTE=0

# KMS 主密钥（可选 · 与嵌入式模式共享）
# 显式注入时优先使用；否则由机器码派生
# CYP_KMS_MASTER_KEY=

# ============================================
# 服务注册与发现（统一运行模式 · 默认全开）
# ============================================

# 服务注册模式：consul（集群默认，不可达自动降级保护）| local（显式本地模式）
# 默认: consul（统一运行模式 · 单节点也是完整集群）
# Consul 不可达时自动降级为本地缓存注册（降级保护，不叫"本地模式"）
SERVICE_REGISTRY_MODE=consul

# Consul Agent HTTP 地址（consul 模式时生效）
# 默认: http://127.0.0.1:8500
# CONSUL_HTTP_ADDR=http://127.0.0.1:8500

# Consul ACL Token（可选，consul 模式启用 ACL 时配置）
# CONSUL_HTTP_TOKEN=

# Consul 服务标签（逗号分隔 key=value 格式）
# 默认: env=prod,app=cyp-memo
# CONSUL_SERVICE_TAGS=env=prod,app=cyp-memo

# ============================================
# 服务网格 mTLS（统一运行模式 · 默认启用）
# ============================================

# 是否启用 mTLS 双向认证
# 1/true/on = 启用；0/false/off = 关闭（不推荐）
# 统一运行模式：默认启用，无证书时自动生成自签证书零配置启动
# 信任域：runtimebase.local（与 KMS SPIFFE 信任根一致）
# 证书 TTL：24 小时，自动轮换
CYP_MTLS_ENABLED=1

# East-West 认证模式（服务间调用）
# both   = 双模式（默认，mTLS 优先，Token 降级，平滑过渡）
# mtls   = 仅 mTLS 证书（需先启用 CYP_MTLS_ENABLED）
# token  = 仅 East-West Token
CYP_EW_AUTH_MODE=both

# ============================================
# 服务网格流量管控（统一运行模式 · 默认启用）
# ============================================

# East-West 流量管控中间件总开关
# 集成：认证 + 限流 + 熔断 + 追踪
# 1/true/on = 启用；0/false/off = 关闭（不推荐）
# 统一运行模式：默认启用
CYP_EW_TRAFFIC_ENABLED=1

# 令牌桶限流开关
# 1/true/on = 启用；0/false/off = 关闭（不推荐）
# 启用后按多维度策略限流：IP/租户/用户/服务/SPIFFE
# 统一运行模式：默认启用，默认宽松策略
CYP_RATE_LIMIT_ENABLED=1

# 令牌桶默认速率（令牌/秒）
# 默认: 1000（统一运行模式 · 宽松默认值）
# CYP_RATE_LIMIT_DEFAULT_RATE=1000

# 令牌桶默认突发容量
# 默认: 2000（统一运行模式 · 宽松默认值）
# CYP_RATE_LIMIT_DEFAULT_BURST=2000

# 熔断冷却基线时间（ms）
# 首次熔断的冷却时长，之后按指数退避增长
# 默认: 2000
# CYP_EGRESS_COOLDOWN_MS=2000

# 熔断冷却最大时间（ms）
# 指数退避的上限
# 默认: 300000（5分钟）
# CYP_EGRESS_COOLDOWN_MAX_MS=300000

# 半开状态恢复所需连续成功次数
# 范围: 1~3
# 默认: 2
# CYP_EGRESS_HALF_SUCCESS=2

# 关闭状态失败阈值（达到则触发熔断）
# 范围: 1~20
# 默认: 1（首次失败即开，出站依赖宜敏）
# CYP_EGRESS_CLOSED_FAIL_THRESHOLD=1
