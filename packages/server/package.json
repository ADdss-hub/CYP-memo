{
  "name": "@cyp-memo/server",
  "version": "2.0.0",
  "description": "CYP-memo 后端 API 服务器",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --conditions=cyp-node dist/index.js",
    "kms": "node --conditions=cyp-node dist/kms-service.js",
    "kms:local": "tsx watch src/kms-service.ts",
    "migrate": "tsx scripts/migrate-to-sqlite.ts",
    "test": "tsx tests/err-smoke.test.ts && tsx tests/upload-guard.test.ts && tsx tests/auth-cookie.test.ts && tsx tests/sql-limit-bind.test.ts && tsx tests/security-headers.test.ts && tsx tests/load-isolation-refuse.test.ts",
    "local": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@cyp-memo/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dexie": "^3.2.4",
    "express": "^4.18.2",
    "@peculiar/x509": "2.1.0",
    "reflect-metadata": "0.2.2",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.10.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
