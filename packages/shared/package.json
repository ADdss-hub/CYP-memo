{
  "name": "@cyp-memo/shared",
  "version": "2.0.1",
  "type": "module",
  "description": "CYP-memo 共享库（数据库、管理器、工具）",
  "author": {
    "name": "CYP",
    "email": "nasDSSCYP@outlook.com"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "cyp-node": "./dist/index.js",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tls/issue": {
      "types": "./src/tls/issue.ts",
      "import": "./src/tls/issue.ts",
      "default": "./src/tls/issue.ts"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "node scripts/build-node.mjs",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@peculiar/x509": "2.1.0",
    "bcryptjs": "^2.4.3",
    "dexie": "^3.2.4",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.15.0",
    "prettier": "^3.1.1",
    "esbuild": "0.21.5",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  }
}
