[Unit]
Description=CYP-memo API (five centers · non-container)
After=network.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=120
User=cyp-memo
WorkingDirectory=/opt/cyp-memo/packages/server
EnvironmentFile=-/opt/cyp-memo/.env
Environment=APP_ENV=prod
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --conditions=cyp-node dist/index.js
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
